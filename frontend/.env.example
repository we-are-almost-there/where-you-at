# frontend/.env.example
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋되지 않는다.
#   cp frontend/.env.example frontend/.env

# 카카오 개발자 콘솔의 JavaScript 키.
# index.html에서 지도 SDK를 부를 때 쓰이며 브라우저에 그대로 노출된다 — 비밀값이 아니다.
# 대신 콘솔의 "앱 설정 > 플랫폼 > Web > 사이트 도메인"에 등록한 주소에서만 동작하므로,
# 배포할 때 배포 도메인을 등록하지 않으면 지도가 뜨지 않는다.
VITE_KAKAO_MAP_KEY=

# 백엔드 API 주소. 로컬에서는 아래 기본값 그대로 두면 된다.
#
# 주의: Vite는 이 값을 빌드 시점에 코드 안에 문자열로 박아 넣는다. 실행할 때 읽지 않는다.
# 배포 환경에서 이 값을 비워 두면 빌드 결과물이 사용자 PC의 localhost:8000을 호출하게 되고,
# 화면은 뜨는데 데이터만 안 나오는 형태로 실패한다. 값을 바꾸면 반드시 다시 빌드해야 한다.
VITE_API_BASE_URL=http://localhost:8000
