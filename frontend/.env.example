# frontend/.env.example
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋되지 않는다.
#   cp frontend/.env.example frontend/.env

# 카카오 개발자 콘솔의 JavaScript 키.
# index.html에서 지도 SDK를 부를 때 쓰이며 브라우저에 그대로 노출된다 — 비밀값이 아니다.
# 대신 콘솔의 "앱 설정 > 플랫폼 > Web > 사이트 도메인"에 등록한 주소에서만 동작하므로,
# 배포할 때 배포 도메인을 등록하지 않으면 지도가 뜨지 않는다.
VITE_KAKAO_MAP_KEY=

# 로그인 전용 카카오 앱의 REST API 키 (위 지도용 앱과 다른 앱이다).
# 카카오 로그인 주소에 client_id로 붙어 브라우저 주소창에 그대로 드러난다. 비밀값이 아니다.
# 백엔드 KAKAO_LOGIN_CLIENT_ID와 같은 값을 넣는다. 클라이언트 시크릿은 절대 여기에 넣지 않는다.
# 로그인 뒤 돌아올 주소는 "현재 주소/auth/kakao/callback"이며, 카카오 콘솔과 백엔드
# KAKAO_LOGIN_REDIRECT_URI에 같은 주소가 등록돼 있어야 한다. 값을 바꾸면 다시 빌드해야 한다.
# 로컬에서는 브라우저로 localhost:5173에 접속한다. 127.0.0.1:5173은 콘솔에 등록되지 않은 주소라 카카오가 막는다(KOE006).
VITE_KAKAO_LOGIN_CLIENT_ID=

# 백엔드 API 주소. 로컬에서는 아래 기본값 그대로 두면 된다.
#
# 주의: Vite는 이 값을 빌드 시점에 코드 안에 문자열로 박아 넣는다. 실행할 때 읽지 않는다.
# 배포 환경에서 이 값을 비워 두면 빌드 결과물이 사용자 PC의 localhost:8000을 호출하게 되고,
# 화면은 뜨는데 데이터만 안 나오는 형태로 실패한다. 값을 바꾸면 반드시 다시 빌드해야 한다.
VITE_API_BASE_URL=http://localhost:8000
