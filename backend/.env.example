# backend/.env.example
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋되지 않는다.
#   cp backend/.env.example backend/.env

# ── 외부 API 키 ────────────────────────────────────────────
# 두루누비(한국관광공사 걷기여행길) — 코스·경로 수집 스크립트에서 사용
DURUNUBI_API_KEY=

# 공공데이터포털(data.go.kr) 일반 인증키 — 반드시 "디코딩된" 키를 넣는다.
# 계정당 하나만 발급되므로 아래 스크립트들이 모두 이 키 하나를 공유한다.
#   - collect_race_tourapi.py     (한국관광공사 TourAPI: 관광지·숙박·대회)
#   - collect_bicycle_facility.py (자전거 대여소)
#   - collect_bicycle_realtime.py (자전거 실시간 현황)
TOUR_API_KEY=

# 자전거 실시간 수집 로그를 backend/logs에도 남길지 여부.
# GitHub Actions나 파일시스템이 영속적이지 않은 환경에서는 false로 둔다.
BICYCLE_FILE_LOG_ENABLED=true

# 카카오 REST API 키 — 좌표를 주소로 바꾸는 데 사용(collect_courses 등).
# 프론트의 지도 SDK가 쓰는 JavaScript 키와는 다른 키다.
# 비워 두면 주소 변환을 건너뛴다(서버 실행 자체에는 지장 없음).
KAKAO_REST_API_KEY=

# ── 카카오 로그인 ─────────────────────────────────────────
# 로그인 전용 카카오 앱의 값이다. 위 KAKAO_REST_API_KEY(좌표 변환 앱)와 섞지 않는다.
# 카카오디벨로퍼스 > 로그인 앱 > [앱] > [플랫폼 키] > [REST API 키] 화면에서 확인한다.
#   KAKAO_LOGIN_CLIENT_ID: 로그인 앱의 REST API 키 (프론트 VITE_KAKAO_LOGIN_CLIENT_ID와 같은 값)
#   KAKAO_LOGIN_CLIENT_SECRET: 같은 화면의 클라이언트 시크릿. 백엔드에만 둔다.
#   KAKAO_LOGIN_REDIRECT_URI: 같은 화면에 등록한 리다이렉트 URI와 한 글자도 달라서는 안 된다(다르면 KOE303).
#     로컬은 http://localhost:5173/auth/kakao/callback, Render에는 배포 도메인 주소를 넣는다.
#     로컬에서는 브라우저도 localhost:5173으로 접속한다. 127.0.0.1:5173은 등록되지 않은 주소라 카카오가 막는다(KOE006).
# 하나라도 비어 있으면 로그인 API가 503을 돌려준다(다른 API는 영향 없음).
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
KAKAO_LOGIN_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 로그인 앱의 어드민 키. 탈퇴할 때 카카오 연결 해제에 쓰고, 연결 끊기 웹훅이 카카오가 보낸 요청인지 확인할 때도 쓴다.
# 비어 있으면 탈퇴 API는 503, 웹훅은 401이 되어 카카오 쪽에서 끊은 연결이 우리 DB에 반영되지 않는다.
# 카카오디벨로퍼스 > 로그인 앱 > [앱] > [어드민 키] 화면에서 확인한다.
# 반드시 "대표" 어드민 키여야 한다. 연결 끊기 웹훅이 대표 어드민 키로 인증 요청을 보내므로,
# 다른 어드민 키를 넣으면 탈퇴는 되는데 웹훅만 401로 조용히 버려진다. 대표 키를 바꾸면 이 값도 함께 바꾼다.
# 모든 권한을 가진 키이므로 서버 환경변수에만 두고, 프론트나 로그, 채팅에 넣지 않는다.
KAKAO_LOGIN_ADMIN_KEY=

# 로그인 토큰 서명 키. 32바이트 이상 난수여야 하며, 짧거나 비어 있으면 로그인이 503을 돌려준다.
# 로컬과 Render에 서로 다른 값을 쓴다. 바꾸면 기존 로그인이 모두 풀린다.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── 새 1:1 문의 Slack 알림 (Render 배포 전용) ───────────────
# 개인정보처리방침 7·8번이 배포된 뒤, 운영팀 전용 비공개 채널의 Incoming Webhook 주소를
# Render 환경변수로만 등록한다. Slack 메시지 보존 기간은 90일로 설정한다.
# 주소가 비어 있거나 전송이 실패해도 문의는 정상 저장된다.
INQUIRY_WEBHOOK_URL=

# ── Supabase PostgreSQL ───────────────────────────────────
# 값은 Supabase 대시보드 > Project Settings > Database 에서 확인한다.
# GitHub Actions 자전거 수집에는 postgres 관리자 대신 06_bicycle_collector_role.sql로 만든
# bicycle_realtime_collector 역할을 사용한다. shared pooler 사용자 이름은
# bicycle_realtime_collector.[PROJECT_REF] 형식이다.
# 주변정보 캐시 갱신에는 07_nearby_cache_role.sql로 만든 nearby_cache_refresher 역할을 쓰고,
# Actions에는 NEARBY_DB_USER(nearby_cache_refresher.[PROJECT_REF])·NEARBY_DB_PASSWORD로 따로 등록한다.
#
# 포트 선택:
#   5432 = 직접 연결. 로컬 개발용.
#   6543 = 커넥션 풀러(PgBouncer). 요청마다 연결을 새로 여는 구조라
#          배포 환경에서는 이쪽을 쓴다. 호스트 주소도 함께 바뀐다.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# ── 이용자 IP 확인 (Render 배포 전용) ──────────────────────
# Render 공개 트래픽이 거치는 Cloudflare의 CF-Connecting-IP를 문의와 로그인 요청 제한에 사용한다.
# 로컬에서는 false로 두고, Render 대시보드에서만 true로 설정한다.
# Render 시작 명령에는 --no-proxy-headers를 넣고 FORWARDED_ALLOW_IPS는 설정하지 않는다.
# 자세한 배포·위조 방지 확인 절차는 README "요청 제한의 이용자 IP 확인"을 따른다.
TRUST_CLOUDFLARE_IP_HEADER=false
