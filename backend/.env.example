# backend/.env.example
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋되지 않는다.
#   cp backend/.env.example backend/.env

# ── 외부 API 키 ────────────────────────────────────────────
# 두루누비(한국관광공사 걷기여행길) — 코스·경로 수집 스크립트에서 사용
DURUNUBI_API_KEY=

# 공공데이터포털(data.go.kr) 일반 인증키 — 반드시 "디코딩된" 키를 넣는다.
# 계정당 하나만 발급되므로 아래 스크립트들이 모두 이 키 하나를 공유한다.
#   - collect_race_tourapi.py     (한국관광공사 TourAPI: 관광지·숙박·대회)
#   - collect_bicycle_facility.py (자전거 대여소)
#   - collect_bicycle_realtime.py (자전거 실시간 현황)
TOUR_API_KEY=

# 자전거 실시간 수집 로그를 backend/logs에도 남길지 여부.
# GitHub Actions나 파일시스템이 영속적이지 않은 환경에서는 false로 둔다.
BICYCLE_FILE_LOG_ENABLED=true

# 카카오 REST API 키 — 좌표를 주소로 바꾸는 데 사용(collect_courses 등).
# 프론트의 지도 SDK가 쓰는 JavaScript 키와는 다른 키다.
# 비워 두면 주소 변환을 건너뛴다(서버 실행 자체에는 지장 없음).
KAKAO_REST_API_KEY=

# ── Supabase PostgreSQL ───────────────────────────────────
# 값은 Supabase 대시보드 > Project Settings > Database 에서 확인한다.
# GitHub Actions 자전거 수집에는 postgres 관리자 대신 06_bicycle_collector_role.sql로 만든
# bicycle_realtime_collector 역할을 사용한다. shared pooler 사용자 이름은
# bicycle_realtime_collector.[PROJECT_REF] 형식이다.
#
# 포트 선택:
#   5432 = 직접 연결. 로컬 개발용.
#   6543 = 커넥션 풀러(PgBouncer). 요청마다 연결을 새로 여는 구조라
#          배포 환경에서는 이쪽을 쓴다. 호스트 주소도 함께 바뀐다.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# ── 프록시 헤더 (Render 배포 전용, 이 파일에 넣지 않는다) ───────
# FORWARDED_ALLOW_IPS: uvicorn이 X-Forwarded-For를 믿을 프록시 주소. 문의 요청 제한이 이용자 IP를 구분하는 데 쓴다.
# uvicorn은 앱을 불러오기 전에 이 값을 읽으므로, 여기(.env)에 적어도 적용되지 않는다(--env-file로 실행할 때만 읽음).
# 로컬은 기본값(127.0.0.1)으로 충분하다. Render에서는 README "문의 요청 제한의 이용자 IP 확인" 절차대로
# 대시보드 환경변수에 * 로 두고 배포한 뒤, 위조 헤더가 무시되는지 확인해 확정한다.
